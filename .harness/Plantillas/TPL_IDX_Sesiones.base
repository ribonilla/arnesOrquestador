# Verificar en Obsidian: sintaxis de Bases (filters, properties, views, sort) no comprobada en una bóveda real.
filters:
  and:
    - note.tipo == "sesion"

properties:
  file.name:
    displayName: "Sesión"
  note.fecha:
    displayName: "Fecha"
  note.tema:
    displayName: "Tema"
  note.estado:
    displayName: "Estado"
  note.tarea:
    displayName: "Tarea"

views:
  - type: table
    name: "Sesiones (tabla)"
    order:
      - file.name
      - note.fecha
      - note.tema
      - note.estado
      - note.tarea
    sort:
      - property: note.fecha
        direction: DESC

  - type: cards
    name: "Sesiones (cards)"
    order:
      - file.name
      - note.fecha
      - note.tema
      - note.estado
      - note.tarea
    sort:
      - property: note.fecha
        direction: DESC
