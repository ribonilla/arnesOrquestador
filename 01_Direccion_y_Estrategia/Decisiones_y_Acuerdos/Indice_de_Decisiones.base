# Verificar en Obsidian
filters:
  and:
    - file.inFolder("01_Direccion_y_Estrategia/Decisiones_y_Acuerdos")
    - or:
        - note.tipo == "decision"
        - note.tipo == "registro"

properties:
  file.name:
    displayName: "Decisión / Registro"
  fecha:
    displayName: "Fecha"
  tema:
    displayName: "Tema"
  estado:
    displayName: "Estado"
  tarea:
    displayName: "Tarea"

views:
  - type: cards
    name: "Decisiones (Cards)"
    order:
      - file.name
      - fecha
      - tema
      - estado
      - tarea
    sort:
      - property: note.fecha
        direction: DESC

  - type: table
    name: "Decisiones (Tabla)"
    order:
      - file.name
      - fecha
      - tema
      - estado
      - tarea
    sort:
      - property: note.fecha
        direction: DESC
