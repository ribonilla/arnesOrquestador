# Verificar en Obsidian
filters:
  and:
    - file.inFolder("01_Direccion_y_Estrategia/Aprendizajes_y_Conocimiento")
    - note.tipo == "aprendizaje"

properties:
  file.name:
    displayName: "Aprendizaje"
  fecha:
    displayName: "Fecha"
  tema:
    displayName: "Tema"
  estado:
    displayName: "Estado"
  tarea:
    displayName: "Tarea"

views:
  - type: cards
    name: "Aprendizajes (Cards)"
    order:
      - file.name
      - fecha
      - tema
      - estado
      - tarea
    sort:
      - property: note.fecha
        direction: DESC

  - type: table
    name: "Aprendizajes (Tabla)"
    order:
      - file.name
      - fecha
      - tema
      - estado
      - tarea
    sort:
      - property: note.fecha
        direction: DESC
